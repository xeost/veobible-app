{
  "name": "veobible-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env production",
    "db:admin": "node scripts/create-admin.mjs",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "build:production": "CLOUDFLARE_ENV=production vinext build",
    "format:check": "prettier --check src scripts vite.config.ts"
  },
  "dependencies": {
    "@remotion/media": "4.0.532",
    "@remotion/player": "4.0.532",
    "jose": "^6.2.12",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "remotion": "4.0.532",
    "vinext": "^1.0.0-beta.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "prettier": "^3.9.9",
    "tsx": "^4.19.4",
    "typescript": "^5.8.0",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  }
}
