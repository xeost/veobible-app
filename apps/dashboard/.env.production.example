# Copy to .env.production only for manual production builds and deployments.
# GitHub Actions receives these values from repository or production environment settings.

# Database, proxy URL and domain are configured in wrangler.jsonc.

# Deployment credentials. Never commit .env.production.
DASHBOARD_CLOUDFLARE_ACCOUNT_ID=
DASHBOARD_CLOUDFLARE_API_TOKEN=

# Runtime secrets, uploaded with the Worker. Each requires at least 32 random bytes.
DASHBOARD_JWT_SECRET=
DASHBOARD_API_PROXY_TOKEN=


# Optional credentials for viewing public website publication progress.
# Use a separate token with Workers Builds read access; the deploy token is not stored in the Worker.
DASHBOARD_PUBLISH_API_TOKEN=
# Manual deployments only: override if the public site uses another account.
# Defaults to DASHBOARD_CLOUDFLARE_ACCOUNT_ID.
DASHBOARD_PUBLISH_ACCOUNT_ID=

# Read-only access to exported website content, shared with the frontend BUILD environment only.
DASHBOARD_SITE_EXPORT_TOKEN=

# R2 S3 credentials scoped to Object Read only on site-releases.
# Required when DASHBOARD_SITE_EXPORT_TOKEN is set; signing account uses DASHBOARD_CLOUDFLARE_ACCOUNT_ID.
DASHBOARD_R2_ACCESS_KEY_ID=
DASHBOARD_R2_SECRET_ACCESS_KEY=
