# JWT signing key; use an independent random secret of at least 32 bytes
JWT_SECRET=replace-with-long-random-jwt-signing-secret
VIDEO_API_TOKEN=replace-with-long-random-shared-token
# Optional Cloudflare Access service token for the tunnel
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Public site publishing; the saved site_settings value takes precedence
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SITE_DEPLOY_HOOK=
