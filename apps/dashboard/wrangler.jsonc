{
  "name": "veobible-dashboard-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veobible-dashboard",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{"binding":"WEBSITE_CONTENT","bucket_name":"site-releases"}],
  "vars": {
    "VIDEO_API_URL": "http://127.0.0.1:8430",
    "SITE_DEV_URL": "http://localhost:3000",
    "SITE_LOCAL": "true",
  },
  "env": {
    "production": {
      "name": "veobible-dashboard",
      "triggers": {"crons": ["*/5 * * * *"]},
      "r2_buckets": [{"binding":"WEBSITE_CONTENT","bucket_name":"site-releases"}],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dashboard",
          "database_id": "801ce9e8-ed31-4c53-9d92-c467b98522c6",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "VIDEO_API_URL": "https://api-proxy-tool.veobible.com",
      },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "dash.veobible.com",
          "custom_domain": true,
        },
      ],
    },
  },
  "$schema": "./node_modules/wrangler/config-schema.json",
  "workers_dev": false,
  "preview_urls": false,
}
