{
  "name": "veobible-dashboard",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dashboard",
      "database_id": "801ce9e8-ed31-4c53-9d92-c467b98522c6",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "VIDEO_API_URL": "https://api-proxy-tool.veobible.com",
  },
  "env": {
    "production": {
      "name": "veobible-dashboard",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dashboard",
          "database_id": "801ce9e8-ed31-4c53-9d92-c467b98522c6",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "VIDEO_API_URL": "https://api-proxy-tool.veobible.com",
      },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "dash.veobible.com",
          "custom_domain": true,
        },
      ],
    },
  },
  "$schema": "./node_modules/wrangler/config-schema.json",
  "workers_dev": false,
  "preview_urls": false,
}