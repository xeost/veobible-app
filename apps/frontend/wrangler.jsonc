{
  "name": "veobible-app",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/en/read/*",
      "/es/leer/*",
      "/pt/ler/*",
      "/en/kjv/*",
      "/en/web/*",
      "/es/rv1909/*",
      "/es/spabll/*",
      "/pt/arc/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://yvavecdfypldbygjquxq.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl2YXZlY2RmeXBsZGJ5Z2pxdXhxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE0MjQwMzYsImV4cCI6MjA5NzAwMDAzNn0.OzvFz1kRMwM3pFmNcwfKPbM3Jz7STFEbX43VgU1yjBk",
    "NEXT_PUBLIC_API_URL": "/api",
    "SUPABASE_URL": "https://yvavecdfypldbygjquxq.supabase.co"
  },
  "routes": [
    {
      "pattern": "veobible.com",
      "custom_domain": true
    }
  ],
  "main": "worker/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veobible-prod",
      "database_id": "0295221a-b6fb-4fad-8848-49598afd5d44",
      "migrations_dir": "worker/migrations"
    }
  ]
}
