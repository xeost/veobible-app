{
  "name": "veobible-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-site.mjs",
    "build": "node scripts/sync-website.mjs && next build && next-image-export-optimizer && node scripts/build-offline.mjs",
    "start": "next start",
    "lint": "next lint",
    "prod-preview": "pnpm build && wrangler dev --persist-to worker/.wrangler/state",
    "deploy": "pnpm build && wrangler deploy",
    "type-check": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "node --import ./tests/loader.mjs --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:api": "node scripts/dev-api.mjs",
    "db:migrate:local": "wrangler d1 migrations apply veobible-prod --local --persist-to worker/.wrangler/state",
    "db:migrate": "wrangler d1 migrations apply veobible-prod --remote",
    "db:migration:new": "wrangler d1 migrations create veobible-prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.62.0",
    "hono": "^4.4.0",
    "lucide-react": "^1.23.0",
    "next": "14.2.29",
    "next-image-export-optimizer": "^1.20.1",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.3.0",
    "react": "^18",
    "react-dom": "^18",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.0.1",
    "babel-loader": "^10.1.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=24"
  }
}
