# Copy this file to `.env.local` and adjust values as needed.
# Variables prefixed with NEXT_PUBLIC_ are inlined at build time.

# Show the "Recommended Content" section in the chapter reader (default: disabled).
# NEXT_PUBLIC_READER_RECOMMENDED_CONTENT=true

# ── Supabase Auth ──────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# The API is served at /api/v1 on the same origin.
# Run pnpm dev:api from the repository root for local synchronization.

# Website build content: server/build-only; never prefix these with NEXT_PUBLIC_.
# SITE_EXPORT_TOKEN=<same-secret-as-frontend-worker>
# SITE_CONTENT_URL=https://veobible.com/api/site-export
# SITE_CONTENT_FILE=/absolute/path/to/a/test-snapshot.json
# SITE_ALLOW_EMPTY=1 # First bootstrap deployment only; remove afterwards.
