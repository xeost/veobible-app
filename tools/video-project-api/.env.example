# VeoBible · Video Project API
# ============================================================
# Configuration template. Copy this file to .env and adjust the values.
# Lines starting with # are comments or disabled options.
# Process environment variables take precedence over this file.
# Narration scripts and social accounts are configured in the dashboard.
# Bible data is always read from apps/frontend/public/bible-data.

# ------------------------------------------------------------
# 1. Service and connection
# ------------------------------------------------------------
# The proxy supplies the port and token when starting this service.
# To run it directly, set PORT and the same PROXY_API_TOKEN
# used by the proxy and dashboard (at least 32 characters).
PORT=8422
PROXY_API_TOKEN=replace-with-long-random-shared-token
# Dashboard origins allowed to receive video generation results.
DASHBOARD_ORIGINS=http://127.0.0.1:3003,http://localhost:3003

# ------------------------------------------------------------
# 2. Working directories
# ------------------------------------------------------------
# An independent root for each format. Supports absolute paths or
# paths relative to tools/video-project-api; absolute paths are recommended.
# Inside each root:
#   material/videos/      intro, outro, and background clips
#   material/voices/      samples for local voice generation
#   material/bible-audio/ original audio when not using an external library
#   outputs/<version>/<passage>/             production dashboard and CLI projects
#   outputs-dev/<version>/<passage>/         development dashboard projects
# Both output trees use _internal/ for numbered voices, scripts and metadata.
# The dashboard selects the output tree per request from its NODE_ENV.
SHORTS_WORKING_DIR=/Users/fabian/Documents/veobible-shorts
LONGS_WORKING_DIR=/Users/fabian/Documents/veobible-longs

# ------------------------------------------------------------
# 3. Bible audio and clips
# ------------------------------------------------------------
# Shared chapter audio library. Each Bible version has its own subdirectory
# (rv1909, kjv, etc.). If omitted, each root uses material/bible-audio.
# VIDEO_AUDIO_DIR=/path/to/bible-audio-library
# A format-specific path takes precedence over the shared library.
# VIDEO_SHORT_AUDIO_DIR=/path/to/short-audio
# VIDEO_LONG_AUDIO_DIR=/path/to/long-audio
# Normally, material/videos inside each root is sufficient.
# Set these options only when clips are stored elsewhere.
# VIDEO_SHORT_VIDEOS_DIR=/path/to/vertical-clips
# VIDEO_LONG_VIDEOS_DIR=/path/to/horizontal-clips

# ------------------------------------------------------------
# 4. Rendering
# ------------------------------------------------------------
# Render concurrency per video. If omitted, Remotion selects it automatically.
# Increasing concurrency may speed up rendering and also use more memory.
# VIDEO_SHORT_RENDER_CONCURRENCY=4
# VIDEO_LONG_RENDER_CONCURRENCY=4
# FFmpeg is detected automatically. Set paths only to use another installation.
# VIDEO_SHORT_FFMPEG=/path/to/ffmpeg
# VIDEO_LONG_FFMPEG=/path/to/ffmpeg

# ------------------------------------------------------------
# 5. Voice provider
# ------------------------------------------------------------
# chatterbox: local synthesis using voice-generator.
# elevenlabs: synthesis using the ElevenLabs service and its credentials.
# VIDEO_SHORT_TTS_PROVIDER=chatterbox
# VIDEO_LONG_TTS_PROVIDER=chatterbox

# ------------------------------------------------------------
# 6. Local synthesis with Chatterbox
# ------------------------------------------------------------
# Defaults to ../voice-generator/cli.py and its .venv/bin/python.
# These paths allow using another voice-generator installation.
# VIDEO_TTS_SCRIPT=/path/to/voice-generator/cli.py
# VIDEO_SHORT_TTS_PYTHON=/path/to/voice-generator/.venv/bin/python
# VIDEO_LONG_TTS_PYTHON=/path/to/voice-generator/.venv/bin/python
# Default model for each format; MODEL_ES, MODEL_EN, and MODEL_PT allow
# selecting a different model for an individual language.
# VIDEO_SHORT_TTS_MODEL=multilingual
# VIDEO_LONG_TTS_MODEL=multilingual
# The low profile uses CPU even when the requested device is auto.
# Explicit mps/cuda requires VOICE_GENERATOR_PROFILE=standard.
# VIDEO_SHORT_TTS_DEVICE=cpu
# VIDEO_LONG_TTS_DEVICE=cpu

# Low-consumption defaults shared by dashboard and CLI voice generation.
# CPU + two threads + lower priority keep the computer responsive.
# Memory values are MiB; the supervisor checks RAM every 0.5 seconds.
VOICE_GENERATOR_PROFILE=low
VOICE_GENERATOR_THREADS=2
VOICE_GENERATOR_MAX_MEMORY_MB=6144
VOICE_GENERATOR_MIN_FREE_MEMORY_MB=3072
VOICE_GENERATOR_TIMEOUT_SECONDS=1800
VOICE_GENERATOR_LOCK_TIMEOUT_SECONDS=300

# ------------------------------------------------------------
# 7. Voice samples for short videos
# ------------------------------------------------------------
# Defaults to es.mp3, en.mp3, and pt.mp3 in material/voices.
# A language sample is used for both intro and outro; a section-specific sample
# takes precedence. These options apply only to Chatterbox.
# VIDEO_SHORT_TTS_VOICE_PROMPT_ES=/path/to/sample-es.mp3
# VIDEO_SHORT_TTS_VOICE_PROMPT_EN=/path/to/sample-en.mp3
# VIDEO_SHORT_TTS_VOICE_PROMPT_PT=/path/to/sample-pt.mp3
# VIDEO_SHORT_TTS_VOICE_PROMPT_ES_INTRO=/path/to/sample-es-intro.mp3
# VIDEO_SHORT_TTS_VOICE_PROMPT_ES_OUTRO=/path/to/sample-es-outro.mp3
# VIDEO_SHORT_TTS_VOICE_PROMPT_EN_INTRO=/path/to/sample-en-intro.mp3
# VIDEO_SHORT_TTS_VOICE_PROMPT_EN_OUTRO=/path/to/sample-en-outro.mp3
# VIDEO_SHORT_TTS_VOICE_PROMPT_PT_INTRO=/path/to/sample-pt-intro.mp3
# VIDEO_SHORT_TTS_VOICE_PROMPT_PT_OUTRO=/path/to/sample-pt-outro.mp3

# ------------------------------------------------------------
# 8. Voice samples for long videos
# ------------------------------------------------------------
# Uses the same precedence rules as short videos.
# VIDEO_LONG_TTS_VOICE_PROMPT_ES=/path/to/sample-es.mp3
# VIDEO_LONG_TTS_VOICE_PROMPT_EN=/path/to/sample-en.mp3
# VIDEO_LONG_TTS_VOICE_PROMPT_PT=/path/to/sample-pt.mp3
# VIDEO_LONG_TTS_VOICE_PROMPT_ES_INTRO=/path/to/sample-es-intro.mp3
# VIDEO_LONG_TTS_VOICE_PROMPT_ES_OUTRO=/path/to/sample-es-outro.mp3
# VIDEO_LONG_TTS_VOICE_PROMPT_EN_INTRO=/path/to/sample-en-intro.mp3
# VIDEO_LONG_TTS_VOICE_PROMPT_EN_OUTRO=/path/to/sample-en-outro.mp3
# VIDEO_LONG_TTS_VOICE_PROMPT_PT_INTRO=/path/to/sample-pt-intro.mp3
# VIDEO_LONG_TTS_VOICE_PROMPT_PT_OUTRO=/path/to/sample-pt-outro.mp3

# ------------------------------------------------------------
# 9. ElevenLabs (only when this provider is selected)
# ------------------------------------------------------------
# The API key is private; each format using ElevenLabs requires a key.
# The default model is eleven_multilingual_v2. Each language requires
# a voice ID. These options are not used with Chatterbox.
# VIDEO_SHORT_ELEVENLABS_API_KEY=your-private-api-key
# VIDEO_SHORT_ELEVENLABS_MODEL=eleven_multilingual_v2
# VIDEO_SHORT_ELEVENLABS_VOICE_ES=voice-id-es
# VIDEO_SHORT_ELEVENLABS_VOICE_EN=voice-id-en
# VIDEO_SHORT_ELEVENLABS_VOICE_PT=voice-id-pt
# VIDEO_LONG_ELEVENLABS_API_KEY=your-private-api-key
# VIDEO_LONG_ELEVENLABS_MODEL=eleven_multilingual_v2
# VIDEO_LONG_ELEVENLABS_VOICE_ES=voice-id-es
# VIDEO_LONG_ELEVENLABS_VOICE_EN=voice-id-en
# VIDEO_LONG_ELEVENLABS_VOICE_PT=voice-id-pt
