# Copia este archivo como .env y adapta las rutas a tu equipo.
# Si omites OUTPUT_DIR, se usa WORKING_DIR/outputs.
VEOBIBLE_SHORTS_WORKING_DIR=/Users/fabian/Documents/veobible-shorts
VEOBIBLE_SHORTS_OUTPUT_DIR=/Users/fabian/Documents/veobible-shorts/outputs
VEOBIBLE_SHORTS_AUDIO_DIR=/Users/fabian/Documents/audiobibles/sources/audios
VEOBIBLE_SHORTS_BIBLE_DATA_DIR=/Users/fabian/Documents/CodeProjects/github.com/xeost/veobible-app/frontend/public/bible-data
# Usa el Python donde instalaste chatterbox-tts. Deja el modelo multilingual para es/en/pt.
VEOBIBLE_SHORTS_TTS_PYTHON=/Users/fabian/Documents/CodeTrying/kokoro/chatterbox/.venv/bin/python
VEOBIBLE_SHORTS_TTS_MODEL=multilingual
VEOBIBLE_SHORTS_TTS_DEVICE=auto
# Muestras de voz independientes (WAV/MP3, idealmente 5-10 segundos).
VEOBIBLE_SHORTS_TTS_VOICE_PROMPT_ES=/Users/fabian/Documents/veobible-shorts/voices/es.mp3
VEOBIBLE_SHORTS_TTS_VOICE_PROMPT_EN=/Users/fabian/Documents/veobible-shorts/voices/en.mp3
VEOBIBLE_SHORTS_TTS_VOICE_PROMPT_PT=/Users/fabian/Documents/veobible-shorts/voices/pt.mp3
# Opcional: modelo por idioma. El modelo latam solo admite español.
# VEOBIBLE_SHORTS_TTS_MODEL_ES=latam
# VEOBIBLE_SHORTS_TTS_MODEL_EN=multilingual
# VEOBIBLE_SHORTS_TTS_MODEL_PT=multilingual
# Opcional: muestra compartida como respaldo para idiomas sin ruta específica.
# VEOBIBLE_SHORTS_TTS_VOICE_PROMPT=/ruta/a/voz-compartida.wav
# Opcional: usa un JSON de plantillas alternativo en vez de voice-templates.json.
# VEOBIBLE_SHORTS_TTS_TEMPLATES=/ruta/a/voice-templates.json
