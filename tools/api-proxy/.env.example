# VeoBible | API Proxy
# ============================================================
# Copy .env.example to .env and adjust the values for your machine.
# Keep .env private; never commit real tokens to version control.
# Start the proxy and video API with: pnpm start:api-proxy
# Run commands from the repository root. Restart services after changes.

# ------------------------------------------------------------
# 1. Working directory
# ------------------------------------------------------------
# Shared base directory for local tools.
# The video API appends SHORTS_DIR_NAME and LONGS_DIR_NAME to this path.
# Use an absolute path; configure format directory names in video-project-api/.env.
WORKING_DIR=/path/to/veobible-working-dir

# ------------------------------------------------------------
# 2. Local services
# ------------------------------------------------------------
# Both services listen on 127.0.0.1. Each port must be unique.
# The proxy starts the video API and supplies its port automatically.
PROXY_PORT=8420
VIDEO_PORT=8422

# ------------------------------------------------------------
# 3. API authentication
# ------------------------------------------------------------
# Private token shared by the proxy, video API, and dashboard.
# Use a long, random value containing at least 32 characters.
# Configure this token only here; the proxy passes it to the video API.
# Shell environment variables cannot override this value.
API_TOKEN=replace-with-long-random-shared-token

# ------------------------------------------------------------
# 4. Dashboard access
# ------------------------------------------------------------
# Comma-separated dashboard origins, including the scheme and port.
# Add the production dashboard origin when using a tunnel.
DASHBOARD_ORIGINS=http://127.0.0.1:3003,http://localhost:3003

# ------------------------------------------------------------
# 5. Cloudflare Tunnel
# ------------------------------------------------------------
# Token for an existing named tunnel targeting http://127.0.0.1:<PROXY_PORT>.
# Leave empty when tunnel access is not needed.
# Start with: pnpm tunnel:api-proxy
# Configure this token only here; environment overrides and command-line
# options are not supported. This token is never passed to the video API.
CLOUDFLARE_TUNNEL_TOKEN=
