PORT=8422
VIDEO_API_TOKEN=replace-with-long-random-shared-token
# Paths are relative to this API package; absolute paths are also supported.
VIDEO_MEDIA_DIR=./media
VIDEO_AUDIO_DIR=./material/bible-audio
DASHBOARD_ORIGINS=http://127.0.0.1:3003,http://localhost:3003
# Defaults: material/short/{videos,voices}, material/long/{videos,voices}
# VIDEO_SHORT_VIDEOS_DIR=/absolute/path/to/vertical-clips
# VIDEO_LONG_VIDEOS_DIR=/absolute/path/to/landscape-clips
# VIDEO_SHORT_TTS_PROVIDER=chatterbox
# VIDEO_LONG_TTS_PROVIDER=chatterbox
# VIDEO_TTS_SCRIPT=/absolute/path/to/voice-generator/cli.py
# VIDEO_SHORT_TTS_PYTHON=/absolute/path/to/voice-generator/.venv/bin/python
# VIDEO_LONG_TTS_PYTHON=/absolute/path/to/voice-generator/.venv/bin/python
# VIDEO_SHORT_TTS_MODEL=multilingual
# VIDEO_LONG_TTS_MODEL=multilingual
# VIDEO_SHORT_RENDER_CONCURRENCY=4
# VIDEO_LONG_RENDER_CONCURRENCY=4
